<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AguaExpress.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primario">#0077B6</Color>
            <Color x:Key="PrimarioOscuro">#023E8A</Color>
            <Color x:Key="Fondo">#F1F7FB</Color>
            <Color x:Key="Exito">#2E9E5B</Color>
            <Color x:Key="Alerta">#E07A00</Color>
            <Color x:Key="Peligro">#C62828</Color>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="#0077B6"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="MinimumHeightRequest" Value="48"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>

            <Style x:Key="BotonSecundario" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="#0077B6"/>
                <Setter Property="BorderColor" Value="#0077B6"/>
                <Setter Property="BorderWidth" Value="1.5"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="MinimumHeightRequest" Value="48"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="Black"/>
                <Setter Property="PlaceholderColor" Value="Gray"/>
            </Style>

            <Style x:Key="Tarjeta" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="Stroke" Value="#D6E4EE"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
                <Setter Property="Padding" Value="14"/>
                <Setter Property="Margin" Value="12,6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>