<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AguaExpress.App.ViewModels" x:Class="AguaExpress.App.Vistas.TrabajadoresPage" Title="Trabajadores">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="＋ Nuevo" Command="{Binding NuevoCommand}"/>
        <ToolbarItem Text="Salir" Command="{Binding CerrarSesionCommand}"/>
    </ContentPage.ToolbarItems>
    <RefreshView IsRefreshing="{Binding Ocupado}" Command="{Binding CargarCommand}">
        <CollectionView ItemsSource="{Binding Trabajadores}" EmptyView="Sin trabajadores">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tarjeta}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrabajadoresViewModel}}, Path=AlternarActivoCommand}" CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding NombreCompleto}" FontAttributes="Bold" FontSize="17"/>
                                <Label Text="{Binding Resumen}" TextColor="Gray" FontSize="12"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding EstadoTexto}" VerticalOptions="Center" TextColor="{StaticResource Exito}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
