<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AguaExpress.App.ViewModels" x:Class="AguaExpress.App.Vistas.InventarioPage" Title="Inventario">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="＋ Nuevo" Command="{Binding NuevoCommand}"/>
        <ToolbarItem Text="Salir" Command="{Binding CerrarSesionCommand}"/>
    </ContentPage.ToolbarItems>
    <RefreshView IsRefreshing="{Binding Ocupado}" Command="{Binding CargarCommand}">
        <CollectionView ItemsSource="{Binding Sifones}" EmptyView="Sin sifones registrados">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tarjeta}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventarioViewModel}}, Path=EditarCommand}" CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="17"/>
                                <Label Text="{Binding StockTexto}" TextColor="Gray"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding PrecioTexto}" FontAttributes="Bold" VerticalOptions="Center" TextColor="{StaticResource Primario}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
