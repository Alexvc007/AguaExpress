<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AguaExpress.App.ViewModels" x:Class="AguaExpress.App.Vistas.MisPedidosPage" Title="Mis pedidos">
    <ContentPage.ToolbarItems><ToolbarItem Text="Salir" Command="{Binding CerrarSesionCommand}"/></ContentPage.ToolbarItems>
    <RefreshView IsRefreshing="{Binding Ocupado}" Command="{Binding CargarCommand}">
        <CollectionView ItemsSource="{Binding Pedidos}" EmptyView="Aún no has hecho pedidos 💧">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="17"/>
                                <Label Grid.Column="1" Text="{Binding EstadoTexto}" FontAttributes="Bold" TextColor="{StaticResource Primario}"/>
                            </Grid>
                            <Label Text="{Binding FechaTexto}" TextColor="Gray" FontSize="12"/>
                            <Label Text="{Binding ItemsTexto}"/>
                            <Label Text="{Binding TotalTexto}" FontAttributes="Bold"/>
                            <Label Text="{Binding MotivoNoEntrega, StringFormat='Motivo: {0}'}" IsVisible="{Binding TieneMotivo}" TextColor="{StaticResource Alerta}"/>
                            <Button Text="Cancelar pedido" BackgroundColor="{StaticResource Peligro}" IsVisible="{Binding PuedeCancelar}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MisPedidosViewModel}}, Path=CancelarCommand}" CommandParameter="{Binding .}"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
