<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AguaExpress.App.ViewModels" x:Class="AguaExpress.App.Vistas.PanelPage" Title="Panel">
    <ContentPage.ToolbarItems><ToolbarItem Text="Salir" Command="{Binding CerrarSesionCommand}"/></ContentPage.ToolbarItems>
    <RefreshView IsRefreshing="{Binding Ocupado}" Command="{Binding CargarCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="12" Spacing="4">
                <Label Text="{Binding NombreUsuario, StringFormat='Hola, {0} 👋'}" FontSize="20" FontAttributes="Bold" Margin="8,4"/>
                <Border Style="{StaticResource Tarjeta}" BackgroundColor="{StaticResource Primario}">
                    <VerticalStackLayout>
                        <Label Text="Ingresos de hoy" TextColor="#CDE8F7"/>
                        <Label Text="{Binding IngresosHoy}" TextColor="White" FontSize="34" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout>
                        <Label Text="Sifones entregados hoy" TextColor="Gray"/>
                        <Label Text="{Binding SifonesEntregados}" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Exito}"/>
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="0">
                    <Border Style="{StaticResource Tarjeta}" Grid.Column="0" Margin="12,6,4,6" Padding="8"><VerticalStackLayout><Label Text="Pendientes" FontSize="12" TextColor="Gray"/><Label Text="{Binding Pendientes}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Alerta}"/></VerticalStackLayout></Border>
                    <Border Style="{StaticResource Tarjeta}" Grid.Column="1" Margin="4,6" Padding="8"><VerticalStackLayout><Label Text="En camino" FontSize="12" TextColor="Gray"/><Label Text="{Binding EnCamino}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primario}"/></VerticalStackLayout></Border>
                    <Border Style="{StaticResource Tarjeta}" Grid.Column="2" Margin="4,6,12,6" Padding="8"><VerticalStackLayout><Label Text="Entregados" FontSize="12" TextColor="Gray"/><Label Text="{Binding EntregadosHoy}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Exito}"/></VerticalStackLayout></Border>
                </Grid>
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="⚠️ Stock bajo" FontAttributes="Bold" TextColor="{StaticResource Peligro}"/>
                        <CollectionView ItemsSource="{Binding StockBajo}" EmptyView="Todo el inventario está en orden ✅">
                            <CollectionView.ItemTemplate><DataTemplate><Label Text="{Binding .}" Padding="0,2"/></DataTemplate></CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
