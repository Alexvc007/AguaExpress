<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AguaExpress.App.ViewModels" x:Class="AguaExpress.App.Vistas.PedidosAdminPage" Title="Pedidos">
    <ContentPage.ToolbarItems><ToolbarItem Text="Salir" Command="{Binding CerrarSesionCommand}"/></ContentPage.ToolbarItems>
    <RefreshView IsRefreshing="{Binding Ocupado}" Command="{Binding CargarCommand}">
        <CollectionView ItemsSource="{Binding Pedidos}" EmptyView="No hay pedidos todavía">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tarjeta}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PedidosAdminViewModel}}, Path=OpcionesCommand}" CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="3">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="17"/>
                                <Label Grid.Column="1" Text="{Binding EstadoTexto}" FontAttributes="Bold" TextColor="{StaticResource Primario}"/>
                            </Grid>
                            <Label Text="{Binding ClienteNombre}"/>
                            <Label Text="{Binding Direccion}" TextColor="Gray"/>
                            <Label Text="{Binding ItemsTexto}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding RepartidorTexto}" TextColor="Gray" FontSize="12"/>
                                <Label Grid.Column="1" Text="{Binding TotalTexto}" FontAttributes="Bold"/>
                            </Grid>
                            <Label Text="{Binding MotivoNoEntrega, StringFormat='Motivo: {0}'}" IsVisible="{Binding TieneMotivo}" TextColor="{StaticResource Alerta}"/>
                            <Label Text="Toca para asignar o cancelar" FontSize="11" TextColor="Gray"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
